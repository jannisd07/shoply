# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables & credentials (IMPORTANT: Never commit!)
lib/core/config/env.dart
*.env
*.env.*

# Firebase configuration files
google-services.json
GoogleService-Info.plist
lib/firebase_options.dart

# Generated files
*.g.dart
*.freezed.dart

# Releases (APK files)
/releases/

# Agent/AI tooling (local state, never commit)
.claude/worktrees/
.claude/worktree-backups/
.claude/settings.local.json
.agents/
.emergent/
.gitnexus
.windsurfrules
.gitconfig

# macOS "file 2" duplicates & local build variants
build.nosync/
build 2/
build 3/
build 4/
.dart_tool 2/
.flutter-plugins-dependencies *
ios/.symlinks 2/
ios/Flutter/Flutter *.podspec
ios/Flutter/Generated *.xcconfig
ios/Flutter/flutter_export_environment *.sh
ios/Podfile *.lock
*.pbxproj.backup
ios/Runner/Configuration.storekit

# One-off outputs
scripts/*.log
test_reports/
flutter_*.log

# Xcode scratch that appears when switching toolchains or opening the project
ios/Runner.xcodeproj/**/xcschemes/*.backup
ios/Runner.xcodeproj/xcshareddata/xcodecloud/
ios/Runner.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# `build` may be a symlink to a non-synced location on machines where the
# project sits in iCloud Drive; the trailing-slash pattern misses that.
build
